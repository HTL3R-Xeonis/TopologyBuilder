#!/usr/bin/env bash

set -e

PYTHON=".venv/Scripts/python.exe"

if [ ! -x "$PYTHON" ]; then
    echo "Virtual environment not found."
    exit 1
fi

echo "Code Formatieren ..."
"$PYTHON" -m ruff check --fix --target-version=py312 .
"$PYTHON" -m ruff format --target-version=py312 .

echo "Prüfe installierte Abhängigkeiten ..."

if ! "$PYTHON" -m pip check; then
    echo "Fehler: Fehlende oder inkompatible Packages!" >&2
    exit 1
fi

echo "requirements.txt wird aktualisiert ..."

if ! "$PYTHON" -m piptools compile \
    --quiet \
    --output-file=requirements.txt \
    pyproject.toml; then
    echo "Fehler beim Erstellen der requirements.txt!" >&2
    exit 1
fi

git add requirements.txt

echo "Hook erfolgreich."