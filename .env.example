# Copy this file to .env (already git-ignored) and fill in your own values.
# Loaded automatically at startup via python-dotenv - no extra flag needed.
# CLI flags (--esxi_password/--gns3_password) always take precedence over
# these if both are given.

ESXI_PASSWORD=
GNS3_PASSWORD=

# Set to "true" to use the hardcoded template name lists in
# src/settings/settings.py (Settings.API.LITERAL_ESXI_TEMPLATES/
# LITERAL_GNS3_TEMPLATES) instead of querying the real Template-API
# services. Useful for offline testing; leave unset/"false" for real use.
LITERAL_API_VALUES=false
